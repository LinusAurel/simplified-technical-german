{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STG-DE central dictionary",
  "type": "object",
  "required": [
    "schema_version",
    "release",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "release": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "meaning": {
      "type": "object",
      "required": [
        "id",
        "definition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "entry_id",
        "lemma",
        "part_of_speech",
        "status",
        "meanings"
      ],
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "lemma": {
          "type": "string",
          "minLength": 1
        },
        "part_of_speech": {
          "type": "string"
        },
        "status": {
          "enum": [
            "approved",
            "restricted",
            "technical_only"
          ]
        },
        "meanings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/meaning"
          }
        },
        "surface_forms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plural": {
          "type": [
            "string",
            "null"
          ]
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "case_sensitive": {
          "type": "boolean"
        }
      }
    }
  }
}