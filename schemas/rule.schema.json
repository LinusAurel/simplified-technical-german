{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STG-DE rule index",
  "type": "object",
  "required": [
    "id",
    "title",
    "source",
    "level"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^STG(?:(?:-DE)?-[0-9]+\\.[0-9]+|-GR-[0-9]+)$"
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "transfer": {
      "type": [
        "string",
        "null"
      ]
    },
    "level": {
      "enum": [
        "MUST",
        "MUST_NOT",
        "SHOULD",
        "SHOULD_NOT",
        "MAY",
        "RECOMMENDATION"
      ]
    },
    "file": {
      "type": "string"
    }
  }
}